rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/shared_board {
      allow read, write: if true;
    }
    match /app_data/shared_paid_leaves {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is map;
      allow delete: if false;
    }
  }
}
